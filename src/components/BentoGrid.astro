</div>

<script>
	// Theme toggle functionality
	const themeToggle = document.getElementById('theme-toggle');
	const html = document.documentElement;
	const sunIcon = document.querySelector('.sun-icon');
	const moonIcon = document.querySelector('.moon-icon');

	// Check for saved theme preference or default to dark
	const savedTheme = localStorage.getItem('theme') || 'dark';
	applyTheme(savedTheme);

	themeToggle?.addEventListener('click', () => {
		const currentTheme = html.getAttribute('data-theme') || 'dark';
		const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
		applyTheme(newTheme);
		localStorage.setItem('theme', newTheme);
	});

	function applyTheme(theme) {
		html.setAttribute('data-theme', theme);
		if (theme === 'dark') {
			sunIcon.style.display = 'block';
			moonIcon.style.display = 'none';
		} else {
			sunIcon.style.display = 'none';
			moonIcon.style.display = 'block';
		}
	}
</script>

<style>
	:root {
		--bg-primary: #0a0a0a;
		--bg-secondary: #111111;
		--bg-surface: rgba(17, 17, 17, 0.98);
		--text-primary: #ffffff;
		--text-secondary: #a3a3a3;
		--border-color: rgba(212, 165, 116, 0.15);
		--accent-color: #d4a574;
		--accent-hover: #e6b88a;
		--surface-border: rgba(212, 165, 116, 0.08);
		--shadow-color: rgba(0, 0, 0, 0.4);
	}

	[data-theme="light"] {
		--bg-primary: #ffffff;
		--bg-secondary: #ffffff;
		--bg-surface: #ffffff;
		--text-primary: #1a1a1a;
		--text-secondary: #666666;
		--border-color: rgba(0, 0, 0, 0.12);
		--surface-border: rgba(0, 0, 0, 0.06);
		--shadow-color: rgba(0, 0, 0, 0.08);
	}

	.bento-container {
		position: relative;
		z-index: 1;
		padding: 1.5rem;
		height: 100vh;
		max-height: 100vh;
		overflow: hidden;
		background: var(--bg-primary);
	}

	.theme-toggle {
		position: absolute;
		top: 1.5rem;
		right: 1.5rem;
		z-index: 100;
		background: var(--bg-surface);
		border: 1px solid var(--border-color);
		border-radius: 999px;
		padding: 0.5rem;
		cursor: pointer;
		color: var(--accent-color);
			transition: all 0.3s ease;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.theme-toggle:hover {
		background: rgba(212, 165, 116, 0.15);
		transform: rotate(180deg);
	}

	.sun-icon {
		display: block;
	}

	.moon-icon {
		display: none;
	}

	[data-theme="light"] .sun-icon {
		display: none;
	}

	[data-theme="light"] .moon-icon {
		display: block;
	}

	.bento-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		grid-template-rows: repeat(2, 1fr);
		gap: 1rem;
		height: 100%;
	}

	/* Base Tile Styles */
	.bento-tile {
		background: var(--bg-surface);
		border: 1px solid var(--border-color);
		border-radius: 0.875rem;
		padding: 1.25rem;
		position: relative;
		overflow: hidden;
		animation: slideUp 0.6s ease-out forwards;
		opacity: 0;
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.bento-tile::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: linear-gradient(135deg, rgba(212, 165, 116, 0.05) 0%, transparent 50%);
		opacity: 0;
		transition: opacity 0.3s ease;
		pointer-events: none;
	}

	.bento-tile:hover {
		transform: translateY(-4px);
		border-color: var(--accent-color);
		box-shadow: 0 12px 28px var(--shadow-color), 0 0 0 1px var(--accent-color);
	}

	.bento-tile:hover::before {
		opacity: 1;
	}

	/* Project Link Styles */
	.project-link {
		text-decoration: none;
		color: inherit;
		display: block;
	}

	/* Tile Content */
	.tile-content {
		height: 100%;
		display: flex;
		flex-direction: column;
		position: relative;
		z-index: 1;
	}

	/* ====================
   Hero Tile
   ==================== */
	.hero-tile {
		background: linear-gradient(145deg, var(--bg-secondary) 0%, rgba(15, 15, 15, 1) 100%);
	}

[data-theme="light"] .hero-tile {
		background: linear-gradient(145deg, #ffffff 0%, #f8f8f8 100%);
		border: 1px solid rgba(0, 0, 0, 0.08);
	}

.hero-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1.25rem;
	}

.avatar-badge {
		width: 56px;
		height: 56px;
		border-radius: 14px;
		background: linear-gradient(135deg, #d4a574 0%, #c49464 100%);
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: 'JetBrains Mono', monospace;
		font-size: 1.2rem;
		font-weight: 600;
		color: #0a0a0a;
		box-shadow: 0 4px 20px rgba(212, 165, 116, 0.3);
		overflow: hidden;
	}

.avatar-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

.hero-meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 1rem;
		background: rgba(212, 165, 116, 0.12);
		border-radius: 999px;
		border: 1px solid rgba(212, 165, 116, 0.25);
	}

.status-dot {
		width: 6px;
		height: 6px;
		background: #4ade80;
		border-radius: 50%;
		animation: pulse 2s ease-in-out infinite;
	}

	@keyframes pulse {
		0%, 100% { opacity: 1; }
	50% { opacity: 0.5; }
}

.status-text {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.65rem;
		color: #4ade80;
	}

.hero-body {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		flex: 1;
	}

.hero-title {
		display: flex;
		flex-direction: column;
		line-height: 1.05;
	}

.title-primary {
		font-size: 2.5rem;
		font-weight: 700;
		background: linear-gradient(135deg, var(--text-primary) 0%, var(--text-secondary) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
}

[data-theme="light"] .title-primary {
		background: linear-gradient(135deg, #1a1a1a 0%, #3a3a3a 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
}

.title-secondary {
		font-size: 2.5rem;
		font-weight: 700;
		background: linear-gradient(135deg, #d4a574 0%, #e6b88a 100%);
	-webkit-background-clip: text;
	-webkit-text-fill-color: transparent;
		background-clip: text;
}

.hero-subtitle {
	display: flex;
	align-items: center;
	gap: 0.75rem;
	font-size: 1rem;
	font-weight: 500;
	color: var(--text-primary);
}

.accent-line {
		width: 32px;
		height: 3px;
		background: linear-gradient(90deg, #d4a574 0%, #e6b88a 100%);
		border-radius: 2px;
}

.hero-tags {
	display: flex;
	gap: 0.625rem;
	flex-wrap: wrap;
	margin-top: auto;
}

.tag {
	padding: 0.5rem 1rem;
	background: rgba(212, 165, 116, 0.12);
	border: 1px solid rgba(212, 165, 116, 0.25);
	border-radius: 8px;
	font-family: 'JetBrains Mono', monospace;
		font-size: 0.65rem;
	color: #d4a574;
}

/* ====================
   Epicor Tile
   ==================== */
.epicor-tile {
		background: linear-gradient(145deg, rgba(212, 165, 116, 0.12) 0%, var(--bg-secondary) 100%);
}

[data-theme="light"] .epicor-tile {
		background: linear-gradient(145deg, rgba(212, 165, 116, 0.08) 0%, #ffffff 100%);
		border: 1px solid rgba(0, 0, 0, 0.08);
}

.expertise-header {
		display: flex;
		justify-content: space-between;
		align-items: start;
		margin-bottom: 1rem;
}

.expertise-icon {
		width: 40px;
		height: 40px;
		border-radius: 10px;
		background: rgba(212, 165, 116, 0.18);
		border: 1px solid var(--surface-border);
		display: flex;
		align-items: center;
		justify-content: center;
		color: #d4a574;
}

.expertise-badge {
		display: flex;
