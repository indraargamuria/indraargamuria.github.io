			</div>
		</div>

		<!-- Future Slot Tile -->
		<div class="bento-tile future-tile {tiles[5].size}" style="animation-delay: {tiles[5].delay}ms">
			<div class="tile-content">
				<div class="future-content">
					<div class="dots-loader">
						<span></span>
						<span></span>
						<span></span>
